{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=talentflow.db"
  },
  "UseSqlServer": false,
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "https://localhost:5001",
      "http://localhost:3000"
    ]
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "TalentFlowApi",
    "Audience": "TalentFlowClient",
    "ExpiryMinutes": 15
  },
  "FileStorage": {
    "BasePath": "uploads/resumes"
  }
}
